[
 
  {
    "key": "policy_start_date",
    "type": "date-picker",
    "label": "Policy start date *",
    "outputPath": "policy_start_date",
    "validators": [
      {
          "validation": {
            "type": "required"
          }
      },
      {
      "validation": {
        "type": "minDate",
        "value": "today",
        "message": "Policy start date cannot be in the past."
        }
      },
      {
      "validation": {
        "type": "maxDate",
        "value": {
          "relativeTo": "today",
          "days": 60
        },
        "message": "Policy start date must be within 60 days from today."
        }
      }
    ]
  },
  {
    "key": "cover_amount",
    "type": "currency",
    "label": "Death benefit cover amount *",
    "props": {
      "prefix": "R"
    },
    "outputPath": "cover_amount",
    "validators": [
      {
        "validation": {
          "type": "required"
        }
      },
      {
        "validation": {
          "min": 1000000,
          "type": "greaterThanCurrency"
        }
      },
      {
        "validation": {
          "max": 10000000,
          "type": "lessThanCurrency"
        }
      }
    ]
  },
  {
    "key": "year_of_birth",
    "type": "number",
    "label": "Birth year *",
    "outputPath": "year_of_birth",
    "validators": [
      {
        "validation": {
          "type": "required"
        }
      },
      {
      "validation": {
        "type": "min",
        "value": 1976,
        "message": "Year of birth must be within the last 50 years."
      }
      },
      {
        "validation": {
          "type": "max",
          "value": 2026,
          "message": "Year of birth cannot be in the future."
        }
      }
  ]
  },
  {
    "key": "dinosaur_species",
    "type": "select",
    "label": "Dinosaur species *",
    "options": [
      {
        "label": "Tyrannosaurus Rex",
        "value": "tyrannosaurus_rex"
      },
      {
        "label": "Stegosaurus",
        "value": "stegosaurus"
      },
      {
        "label": "Velociraptor",
        "value": "velociraptor"
      },
      {
        "label": "Diplodocus",
        "value": "diplodocus"
      },
      {
        "label": "Iguanodon",
        "value": "iguanodon"
      }
    ],
    "outputPath": "dinosaur_species",
    "validators": [
      {
        "validation": {
          "type": "required"
        }
      }
    ]
  },
  {
    "key": "dinosaur_health_checks",
    "type": "checkbox",
    "label": "Dinosaur health checks up to date?",
    "outputPath": "dinosaur_health_checks",
    "validators": [
      {
        "validation": {
          "type": "required"
        }
      }
    ],
    "defaultValue": false
  }
  
]
