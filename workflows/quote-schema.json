[
 
  {
    "type": "date-picker",
    "label": "Policy start date *",
    "outputPath": "policy_start_date",
    "validators": [ {"validation": { "type": "required" } } ]
  },
  {
    "type": "currency",
    "label": "Death benefit cover amount *",
    "props": { "prefix": "R"  },
    "outputPath": "cover_amount",
    "validators": [{"validation": {"type": "required" }},
      {"validation": {"type": "greaterThanCurrency","min": 1000000}},
      {"validation": {"type": "lessThanCurrency","max": 10000000 } }
    ]
  },
  {
    "type": "number",
    "label": "Birth year *",
    "outputPath": "year_of_birth",
    "validators": [
      { "validation": { "type": "required" }  },
      { "validation": { "type": "greaterThanEqualsToNumber","min":1976   } },
      { "validation": { "type": "lessThanEqualsToNumber","max": 2026     } }
   ]
  },
  {
    "type": "select",
    "label": "Dinosaur species *",
    "options": [
      {
        "label": "Tyrannosaurus Rex"
      },
      {
        "label": "Stegosaurus"
      },
      {
        "label": "Velociraptor"
      },
      {
        "label": "Diplodocus"
      },
      {
        "label": "Iguanodon"
      }
    ],
    "outputPath": "dinosaur_species",
    "validators": [
      {
        "validation": {
          "type": "required"
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "Dinosaur health checks up to date?",
    "outputPath": "dinosaur_health_checks",
    "validators": [
      {
        "validation": {
          "type": "required"
        }
      }
    ],
    "defaultValue": false
  }
  
]
